@startuml
' Generado por spec2code. Es una PROPUESTA del pipeline: audítala contra la spec.
' La herencia NO se traduce a ER: decidir cómo modelarla (tabla única, por clase...) es trabajo tuyo.
hide circle
skinparam linetype ortho

entity Personaje {
  * codigo : varchar <<PK>>
  --
  nombre : varchar
  nivel : int
  ataque_base : int
  defensa_base : int
  ataque_total : int
  defensa_total : int
  arma_equipada : varchar
  armadura_equipada : varchar
}

entity Inventario {
  * codigo : varchar <<PK>>
  --
  capacidad_maxima : int
  peso_total : int
  capacidad_disponible : int
}

entity Objeto {
  * codigo : varchar <<PK>>
  --
  nombre : varchar
  peso : int
  tipo : varchar
  marca_protegido : boolean
  marca_equipado : boolean
}

entity Arma {
  * codigo : varchar <<PK>>
  --
  bono_ataque : int
  nivel_minimo : int
}

entity Armadura {
  * codigo : varchar <<PK>>
  --
  bono_defensa : int
  nivel_minimo : int
}

entity Otro {
  * codigo : varchar <<PK>>
  --
  nombre : varchar
  peso : int
}

Personaje ||--o{ Inventario : tiene
Inventario }o--|| Objeto : contiene
@enduml
